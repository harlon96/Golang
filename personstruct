package main

import (
	"fmt"
)

type person struct {
	first      string
	last       string
	favflavors []string
}

func main() {

	p1 := person{

		first: `Harlon`,
		last:  `Hutch`,
		favflavors: []string{
			`snowsberry`,
			`chocolate`,
			`I love rum & redbull`,
		},
	}

	fmt.Println(p1.first)
	fmt.Println(p1.last)

	for i, v := range p1.favflavors {
		fmt.Println(i, v)

	}

}
