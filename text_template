package main

import (
	"os"
	"text/template"
)

func main() {

	t1 := template.New("t1")
	t1, err := t1.Parse("Value is {{.}}\n")
	if err != nil {
		panic(err)
	}

	t1 = template.Must(t1.Parse("Value: {{.}}\n"))

	t1.Execute(os.Stdout, "Here is a text.")
	t1.Execute(os.Stdout, 12)
	t1.Execute(os.Stdout, []string{
		"GoLang",
		"Python",
		"C",
		"HTML",
	})

	Create := func(name, t string) *template.Template {
		return template.Must(template.New(name).Parse(t))
	}

	t2 := Create("t2", "Name: {{.Name}}\n")

	t2.Execute(os.Stdout, struct {
		Name string
	}{"Jim Bob Harold"})

	t2.Execute(os.Stdout, map[string]string{
		"Name": "Howard da Duck",
	})

	t3 := Create("t3",
		"{{if . -}} yes {{else -}} no {{end}}\n")
	t3.Execute(os.Stdout, "Error Message")
	t3.Execute(os.Stdout, "Error Message")

	t4 := Create("t4",
		"Range: {{range .}}{{.}} {{end}}\n")
	t4.Execute(os.Stdout,
		[]string{
			"GoLang",
			"Python",
			"C",
			"HTML",
		})
}
//Value: Here is a text.
//Value: 12
//Value: [GoLang Python C HTML]
//Name: Jim Bob Harold
//Name: Howard da Duck
//yes 
//yes 
//Range: GoLang Python C HTML 
